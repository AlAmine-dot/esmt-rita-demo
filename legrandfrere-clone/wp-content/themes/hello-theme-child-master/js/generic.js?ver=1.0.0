/*
 * Fonction pour vérifier et supprimer les popups vides
 * */
function cleanEmptyElementorPopups() {
  document.querySelectorAll('.elementor-popup-modal').forEach(function(popup) {
    var shortcodeDiv = popup.querySelector('.elementor-shortcode');
    if (shortcodeDiv && shortcodeDiv.innerHTML.trim() === '') {
      popup.remove();
    }
  });
}
const observer = new MutationObserver(function(mutationsList, observer) {
  cleanEmptyElementorPopups();
});
observer.observe(document.body, { childList: true, subtree: true });
document.addEventListener('DOMContentLoaded', cleanEmptyElementorPopups);




/*
 * Push le datalayer du popup pour tracking event popup display 
 */
jQuery(document).on('elementor/popup/show', function(event, id, instance) {
    if (id === 30669) {
        var popup = document.getElementById('elementor-popup-modal-30669');
        if (popup) {
            var btn = popup.querySelector('[data-etablissement-id]');
            if (btn) {
                var etabId = btn.getAttribute('data-etablissement-id');
                if (etabId) {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'etablissement_popup_display',
                        etablissement_id: etabId,
                        context: window.pageContext || null
                    });
                }
            }
        }
    }
});

/*
 * Push le datalayer de la carte d'établissement abonné pour tracking event card display
 */
jQuery(function($){
    $('.custom-card-header[data-etablissement-id]').each(function(){
        var etabId = $(this).attr('data-etablissement-id');
        var isAbonne = $(this).attr('data-etablissement-abonne') === '1';

        // Event pour tous les établissements
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
            event: 'etablissement_card_display',
            etablissement_id: etabId,
            context: window.pageContext || null
        });

        // Event spécifique pour les établissements abonnés
        if (isAbonne) {
            window.dataLayer.push({
                event: 'etablissement_topcard_display',
                etablissement_id: etabId,
                context: window.pageContext || null
            });
        }
    });
});

/*
 * Push le datalayer lors d'un clic sur un bouton de contact
 * -> Gère les <a> avec le data-attribute ou dont un parent possède la classe et le data-attribute
 */
jQuery(function($) {
    // Configuration des boutons à tracker
    var clickEventsConfig = [
        { classSelector: '.gtm-btn-email',    event: 'etablissement_email_click' },
        { classSelector: '.gtm-btn-facebook', event: 'etablissement_facebook_click' },
        { classSelector: '.gtm-btn-linkedin', event: 'etablissement_linkedin_click' },
        { classSelector: '.gtm-btn-phone',    event: 'etablissement_phone_click' },
        { classSelector: '.gtm-btn-website',  event: 'etablissement_website_click' }
    ];

    // Pour chaque configuration, on écoute les clics sur les <a> descendants du bon parent
    clickEventsConfig.forEach(function(config) {
        $(document).on('click', config.classSelector + ' a, a' + config.classSelector, function(e) {
            var $link = $(this);

            // Cas 1 : <a> a le data-etablissement-id
            var etabId = $link.data('etablissement-id');

            // Cas 2 : parent (gtm-btn-*) a le data-etablissement-id
            if (!etabId) {
                var $parent = $link.closest(config.classSelector + '[data-etablissement-id]');
                if ($parent.length) {
                    etabId = $parent.data('etablissement-id');
                }
            }

            if (etabId) {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: config.event,
                    etablissement_id: etabId,
                    context: window.pageContext || null
                });
            }
        });
    });
});
